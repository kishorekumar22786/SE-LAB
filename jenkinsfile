```groovy
pipeline {

    agent any

    stages {

        stage('Verify Application Files') {

            steps {

                echo 'Verifying project files...'

                bat 'if exist calculator.py (echo calculator.py Found) else (exit 1)'

                bat 'if exist requirements.txt (echo requirements.txt Found) else (exit 1)'

                bat 'if exist README.md (echo README.md Found) else (exit 1)'

                bat 'if exist "test_calculator (1).py" (echo Test file Found) else (exit 1)'
            }
        }

        stage('Create Build Artifact') {

            steps {

                echo 'Creating ZIP file...'

                bat 'powershell Compress-Archive -Path * -DestinationPath StudentManagementSystem.zip -Force'
            }
        }

        stage('Archive Build') {

            steps {

                archiveArtifacts artifacts: 'StudentManagementSystem.zip', fingerprint: true
            }
        }
    }

    post {

        success {

            echo 'Application Build Successful.'
        }

        failure {

            echo 'Application Build Failed.'
        }
    }
}
```
